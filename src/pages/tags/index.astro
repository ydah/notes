---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagMap } from '../../lib/notes';
import { tagUrl } from '../../lib/tags.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagMap = await getTagMap();
const tags = [...tagMap.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'ja'));
const max = tags[0]?.[1].length ?? 1;
---
<BaseLayout title="タグ一覧">
  <h1>🏷️ タグ一覧</h1>
  {tags.length > 0 ? (
    <div class="tag-cloud">
      {tags.map(([tag, taggedNotes]) => (
        <a href={tagUrl(tag, base)} style={`--tag-size: ${0.9 + (taggedNotes.length / max) * 1.1}rem`}>
          #{tag} <small>{taggedNotes.length}</small>
        </a>
      ))}
    </div>
  ) : <p class="muted">まだタグがありません。</p>}
</BaseLayout>
