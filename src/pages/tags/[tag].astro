---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byUpdated, getTagMap } from '../../lib/notes';

export async function getStaticPaths() {
  const tagMap = await getTagMap();
  return [...tagMap.entries()].map(([tag, notes]) => ({
    params: { tag },
    props: { tag, notes: [...notes].sort(byUpdated) },
  }));
}

const { tag, notes } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={`#${tag}`}>
  <h1>#{tag}</h1>
  <p class="muted">{notes.length} 件のノート</p>
  <ul class="note-list">
    {notes.map((note) => <li><a href={`${base}/notes/${note.slug}/`}>{note.title}</a></li>)}
  </ul>
</BaseLayout>
